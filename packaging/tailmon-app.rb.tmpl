# Generated by scripts/release.sh from packaging/tailmon-app.rb.tmpl.
cask "tailmon-app" do
  version "__VERSION__"
  sha256 "__SHA256__"

  url "https://github.com/barathanaslan/tailmon/releases/download/v#{version}/Tailmon-#{version}.zip"
  name "Tailmon"
  desc "Menu bar monitor for a Tailscale fleet, with the tailmon agent built in"
  homepage "https://github.com/barathanaslan/tailmon"

  depends_on arch: :arm64
  depends_on macos: :sonoma

  # Self-contained on purpose: a cask depending on the tap's formula fails for
  # a fresh user (installing a fully qualified cask trusts only that cask).
  # The app carries the tailmon binary and registers the agent service on
  # first launch when no agent answers on 127.0.0.1:7020.
  app "Tailmon.app"
  binary "#{appdir}/Tailmon.app/Contents/Resources/tailmon"

  # Remove the agent service only if it is the one the app installed.
  uninstall quit:   "com.bosphorify.tailmon.menubar",
            script: {
              executable: "#{appdir}/Tailmon.app/Contents/Resources/tailmon",
              args:       ["service", "uninstall", "--if-bin",
                           "#{appdir}/Tailmon.app/Contents/Resources/tailmon"],
            }

  zap trash: [
    "~/Library/Application Support/Tailmon",
    "~/Library/Caches/tailmon",
    "~/Library/Logs/tailmon-agent.log",
    "~/Library/Logs/tailmon-menubar.log",
    "~/Library/Preferences/com.bosphorify.tailmon.menubar.plist",
  ]
end
